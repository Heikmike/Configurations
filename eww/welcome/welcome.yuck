(defwidget welcome []
  (box
    :class "welcome"

    (label
      :class "welcome_text"
      :text "Welcome Heikmike !"
      :valign "center"
      :halign "center"
    )
  )
)

(defwindow welcome
  :monitor 0
  :geometry (geometry :x 0 :y 0 :width "100%" :height "100%" :anchor "center")

  (welcome)
)
